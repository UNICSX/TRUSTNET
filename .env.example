# =============================================================
# Groq API keys — one per agent.
#
# You can reuse the SAME Groq key for all four values, or use
# four separate keys (useful if you want to spread rate limits).
#
# Get a free key at: https://console.groq.com/keys
#
# Copy this file to ".env" and fill in your real key(s).
# The .env file is gitignored and must NEVER be committed.
# =============================================================

GROQ_COORDINATOR_KEY=your_groq_key_here
GROQ_PHISHING_KEY=your_groq_key_here
GROQ_THREAT_KEY=your_groq_key_here
GROQ_SOC_KEY=your_groq_key_here
